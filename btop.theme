# Hogwarts Night btop theme
theme[main_bg]="#0F1117"
theme[main_fg]="#E4DCD0"
theme[title]="#E4DCD0"
theme[hi_fg]="#E5B869"
theme[selected_bg]="#242A38"
theme[selected_fg]="#E5B869"
theme[inactive_fg]="#6B7285"
theme[graph_text]="#EDE6DB"
theme[meter_bg]="#242A38"
theme[proc_misc]="#EDE6DB"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#B382D9"
theme[mem_box]="#63A87E"
theme[net_box]="#D45D68"
theme[proc_box]="#E5B869"

theme[div_line]="#6B7285"

# Temperature graph color (Emerald -> Gold -> Crimson)
theme[temp_start]="#63A87E"
theme[temp_mid]="#E5B869"
theme[temp_end]="#D45D68"

# CPU graph colors (Patronus Teal -> Ravenclaw Azure -> Mystic Amethyst)
theme[cpu_start]="#5BBBB2"
theme[cpu_mid]="#6B95D6"
theme[cpu_end]="#B382D9"

# Mem/Disk free meter
theme[free_start]="#B382D9"
theme[free_mid]="#6B95D6"
theme[free_end]="#5BBBB2"

# Mem/Disk cached meter
theme[cached_start]="#6B95D6"
theme[cached_mid]="#5BBBB2"
theme[cached_end]="#B382D9"

# Mem/Disk available meter
theme[available_start]="#E5B869"
theme[available_mid]="#E28E58"
theme[available_end]="#D45D68"

# Mem/Disk used meter
theme[used_start]="#63A87E"
theme[used_mid]="#5BBBB2"
theme[used_end]="#6B95D6"

# Download graph colors
theme[download_start]="#E5B869"
theme[download_mid]="#E28E58"
theme[download_end]="#D45D68"

# Upload graph colors
theme[upload_start]="#63A87E"
theme[upload_mid]="#5BBBB2"
theme[upload_end]="#6B95D6"

# Process box color gradient
theme[process_start]="#5BBBB2"
theme[process_mid]="#6B95D6"
theme[process_end]="#B382D9"

# Graph gradient colors
theme[gradient_color_0]="#0F1117"
theme[gradient_color_1]="#181B24"
theme[gradient_color_2]="#242A38"
theme[gradient_color_3]="#6B7285"
theme[gradient_color_4]="#82899C"
theme[gradient_color_5]="#E4DCD0"
theme[gradient_color_6]="#EDE6DB"
