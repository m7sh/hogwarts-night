{
  "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
  "name": "Hogwarts Night",
  "author": "Omarchy",
  "themes": [
    {
      "name": "Hogwarts Night",
      "appearance": "dark",
      "style": {
        "background": "#0F1117",
        "editor.background": "#0F1117",
        "editor.foreground": "#E4DCD0",
        "text": "#E4DCD0",
        "text.muted": "#82899C",
        "text.ignored": "#6B7285",
        "text.placeholder": "#6B7285",
        "ignored": "#6B7285",
        "element.hover": "#242A38",
        "ghost_element.hover": "#242A38",
        "ghost_element.selected": "#242A38",
        "ghost_element.active": "#242A38",
        "border": "#242A38",
        "editor.highlighted_line.background": "#181B24",
        "editor.active_line.background": "#181B24",
        "panel.background": "#0F1117",
        "title_bar.background": "#0B0C10",
        "title_bar.inactive_background": "#0B0C10",
        "status_bar.background": "#181B24",
        "drop_target.background": "#242A38",
        "elevated_surface.background": "#181B24",
        "toolbar.background": "#0F1117",
        "tab_bar.background": "#0B0C10",
        "tab.inactive_background": "#0B0C10",
        "tab.active_background": "#181B24",
        "scrollbar.track.background": "transparent",
        "scrollbar.track.border": "transparent",
        "scrollbar.thumb.background": "#242A38",
        "editor.gutter.background": "#0F1117",
        "terminal.background": "#0F1117",
        "terminal.foreground": "#E4DCD0",
        "terminal.dim_foreground": "#82899C",
        "terminal.bright_foreground": "#FAF5EE",
        "terminal.ansi.black": "#181B24",
        "terminal.ansi.red": "#D45D68",
        "terminal.ansi.green": "#63A87E",
        "terminal.ansi.yellow": "#E5B869",
        "terminal.ansi.blue": "#6B95D6",
        "terminal.ansi.magenta": "#B382D9",
        "terminal.ansi.cyan": "#5BBBB2",
        "terminal.ansi.white": "#E4DCD0",
        "terminal.ansi.bright_black": "#545A6C",
        "terminal.ansi.bright_red": "#E57580",
        "terminal.ansi.bright_green": "#78BE93",
        "terminal.ansi.bright_yellow": "#F2C77D",
        "terminal.ansi.bright_blue": "#82A9E5",
        "terminal.ansi.bright_magenta": "#C497E8",
        "terminal.ansi.bright_cyan": "#72CFC7",
        "terminal.ansi.bright_white": "#FAF5EE",
        "modified": "#E5B869",
        "syntax": {
          "attribute": {
            "color": "#E5B869"
          },
          "boolean": {
            "color": "#E28E58"
          },
          "comment": {
            "color": "#6B7285"
          },
          "comment.doc": {
            "color": "#6B7285"
          },
          "constant": {
            "color": "#E5B869"
          },
          "function": {
            "color": "#6B95D6"
          },
          "keyword": {
            "color": "#B382D9"
          },
          "number": {
            "color": "#F2C77D"
          },
          "operator": {
            "color": "#5BBBB2"
          },
          "string": {
            "color": "#63A87E"
          },
          "type": {
            "color": "#82A9E5"
          },
          "variable": {
            "color": "#E4DCD0"
          }
        },
        "players": [
          {
            "cursor": "#E5B869",
            "background": "#D45D68",
            "selection": "#242A38"
          }
        ]
      }
    }
  ]
}
